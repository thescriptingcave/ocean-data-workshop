# caches & downloads
.probes_cache/
*.nc
*.nc4
*.csv.gz
# Anchored to the repo root. An unanchored 'data/' also matches
# src/ocean_sim/data/, which silently excluded the three loaders from every
# commit -- found by cloning to a clean directory and getting
# 'ModuleNotFoundError: No module named ocean_sim.data'.
/data/
runs/

# secrets — never commit
.env
.coopernicusmarine-credentials
credentials.json

# python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# notebooks
.ipynb_checkpoints/
# prefetched API responses -- real data, but regenerable, and large
notebooks/.cache/
# scratch files the notebooks write into the working directory
# the cache-archive IS committed: it is what makes the workshop run with no network
notebooks/cache-archive.tar.gz
notebooks/_*.nc
notebooks/_traps.csv

# macOS
.DS_Store
probes/RESULTS.jsonl

# figures are regenerable from scripts/; keep the HTML so they are
# viewable without rerunning anything, but ignore the matplotlib PNGs
figures/*.png
